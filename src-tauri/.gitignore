# Icons: commit the source PNG + the desktop set referenced by tauri.conf.json;
# ignore the mobile/Windows-Store variants (regenerate via `npm run tauri icon`).
/icons/*
!/icons/app-icon.png
!/icons/32x32.png
!/icons/128x128.png
!/icons/128x128@2x.png
!/icons/icon.icns
!/icons/icon.ico
